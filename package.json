{
  "name": "codex-skills-mcp",
  "version": "1.5.0-beta.1",
  "description": "MCP Server for Codex-Skills - Intelligent skill library search, read and orchestration",
  "type": "module",
  "bin": {
    "codex-skills-mcp": "dist/index.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('assets/app.html','dist/app.html')\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "keywords": [
    "mcp",
    "codex-skills",
    "ai-skills",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openai/mcp-extensions": "^0.1.0",
    "express": "^5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
