{
  "name": "codex-skills-mcp",
  "version": "1.5.0-beta.9",
  "description": "MCP Server for Codex-Skills - Intelligent skill library search, read and orchestration",
  "type": "module",
  "bin": {
    "codex-skills-mcp": "dist/index.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:app && tsc && node -e \"require('fs').copyFileSync('assets/app.html','dist/app.html')\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "node scripts/benchmark-search.mjs",
    "check:package": "node scripts/check-package.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:app": "node scripts/build-app.mjs",
    "benchmark:loader": "node scripts/benchmark-loader.mjs",
    "benchmark:remote": "node scripts/benchmark-remote.mjs",
    "preview:app": "npm run build:app && node scripts/preview-mcp-app.mjs"
  },
  "keywords": [
    "mcp",
    "codex-skills",
    "ai-skills",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/mcp-extensions": "^0.1.0",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "marked": "^18.1.1",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
