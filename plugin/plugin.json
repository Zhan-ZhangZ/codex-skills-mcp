{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-skills",
  "version": "0.7.1",
  "description": "Browse, search, and load an on-demand expert skill library in ChatGPT and Codex.",
  "author": {
    "name": "Zhan-ZhangZ"
  },
  "homepage": "https://github.com/Zhan-ZhangZ/codex-skills-mcp#readme",
  "repository": "https://github.com/Zhan-ZhangZ/codex-skills-mcp",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "codex",
    "codex-plugin",
    "openai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "chatgpt",
    "agent-skills",
    "skill-library",
    "productivity"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex Skills 技能库",
        "shortDescription": "持续更新的按需专家技能库",
        "longDescription": "在支持 MCP Apps 的 ChatGPT/Codex 桌面端中搜索、预览、缓存并把技能带入当前对话；标准 MCP 客户端仍可使用 8 个核心工具。",
        "developerName": "Zhan-ZhangZ",
        "category": "Productivity",
        "capabilities": ["Interactive", "Read"],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "defaultPrompt": ["@Codex Skills 搜索技能关键词，如 PPT、视频翻译、小红书"]
      }
    }
  }
}
