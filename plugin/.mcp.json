{
  "mcpServers": {
    "codex-skills": {
      "command": "./scripts/launch-codex-skills-mcp",
      "args": ["${PLUGIN_ROOT}/dist/server.js"],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "startup_timeout_sec": 120,
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "XDG_CACHE_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ]
    }
  }
}
